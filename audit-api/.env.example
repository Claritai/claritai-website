# ── Claritai Audit API — environment variables ──
# Copy to .env for local dev (never commit real keys). On Render, set these in the
# service's "Environment" tab instead.

# Where your website is served from — locks down CORS. Comma-separate multiple origins.
ALLOWED_ORIGIN=https://claritai.ie,https://www.claritai.ie

# Google PageSpeed Insights API key (free): https://developers.google.com/speed/docs/insights/v5/get-started
PAGESPEED_API_KEY=

# Azure OpenAI (same resource you use for Cargo Command)
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com
AZURE_OPENAI_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_API_VERSION=2024-06-01

# HubSpot Private App token (scopes: crm.objects.contacts.read/write, crm.objects.notes.write)
HUBSPOT_TOKEN=

# Optional: email each audit lead via Formspree (works alongside HubSpot).
# Leave blank to use the site's existing contact form. Set a full endpoint or just the form id to override.
FORMSPREE_ENDPOINT=
FORMSPREE_FORM_ID=

# Optional: requests per IP per minute (default 6)
RATE_LIMIT=6

# Set MOCK=1 to return a canned sample report without calling any external service.
MOCK=0
