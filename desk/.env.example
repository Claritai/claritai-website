# Local development. On Render these are set in the dashboard instead.

# Postgres. Locally: postgres://user:pass@localhost:5432/claritai_desk
DATABASE_URL=

# Long random string used to sign session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# From Google Cloud Console → Credentials → OAuth 2.0 Client ID (see DEPLOY.md)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Only accounts on this Workspace domain can sign in.
ALLOWED_DOMAIN=claritai.ie

# Where this instance is reachable. Must match the Google redirect URI.
BASE_URL=http://localhost:3000
